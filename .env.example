# Lokal geliştirme için docker-compose değişkenleri.
# Kopyalayın: cp .env.example .env
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress

# RDS'te TLS zorunludur (varsayılan 1). Lokal MySQL için docker-compose.yml
# bunu zaten 0 yapar; burada override etmeniz gerekmez.
# WORDPRESS_DB_SSL=0

# --- S3 medya offload (WP Offload Media Lite) ---------------------------------
# Lokalde denemek isterseniz gerçek bir bucket ve IAM kullanıcısı girin.
# Boş bırakılırsa eklenti pasif kalır, medya lokalde saklanır.
# AWS'de (ECS) anahtar GEREKMEZ; task role kullanılır.
# WP_S3_BUCKET=ornek-magaza-medya
# WP_S3_REGION=eu-west-1
# WP_S3_DELIVERY_DOMAIN=cdn.ornek-magaza.com
# WP_S3_REMOVE_LOCAL=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Object cache (ElastiCache Memcached) -------------------------------------
# Çok node'lu cluster'da config endpoint yerine node'ları virgülle listeleyin;
# PHP'nin memcached eklentisi ElastiCache auto-discovery yapmaz.
# MEMCACHED_HOST=n1.xxx.cache.amazonaws.com:11211,n2.xxx.cache.amazonaws.com:11211
# In-transit encryption veya Serverless kullanıyorsanız (stunnel tüneli açılır):
# MEMCACHED_TLS=1
# Sunucu sertifikası doğrulamasını kapatmak için (önerilmez): MEMCACHED_TLS_VERIFY=0
# Cache anahtarı öneki — prod/staging aynı cluster'ı paylaşıyorsa şart:
# WP_CACHE_SALT=prod
