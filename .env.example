# Lokal geliştirme için docker-compose değişkenleri.
# Kopyalayın: cp .env.example .env
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress

# RDS'te TLS zorunludur (varsayılan 1). Lokal MySQL için docker-compose.yml
# bunu zaten 0 yapar; burada override etmeniz gerekmez.
# WORDPRESS_DB_SSL=0
